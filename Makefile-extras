################################################################
# Swaggy C hooks specific to this project
################################################################

# The generated JavaScript client depends on mocha 8 which pins yargs 16.2.0,
# that version fails to load on Node.js 26+ with
# "require is not defined in ES module scope".
# yargs 16.2.2 is the patch release that is loadable on Node.js 26+.
x-pre-test-javascript:
	cd clients/javascript/generated/ && \
	  npm pkg set overrides.yargs=16.2.2

# Both x-post-generate-all and x-post-generate-primary targets make the Ruby
# API client not follow redirects by default, as the generated client's
# `opts[:follow_location] || true` always follows them, and ruby_aem relies on
# getting 302 responses back, e.g. when creating a SAML configuration
RUBY_API_CLIENT_FILE = clients/ruby/generated/lib/swagger_aem_osgi/api_client.rb

x-post-generate-all:
	sed -i \
	  -e "s/opts\[:follow_location\] || true$$/opts[:follow_location] || false/" \
	  $(RUBY_API_CLIENT_FILE)

x-post-generate-primary:
	sed -i \
	  -e "s/opts\[:follow_location\] || true$$/opts[:follow_location] || false/" \
	  $(RUBY_API_CLIENT_FILE)

.PHONY: x-pre-test-javascript x-post-generate-all x-post-generate-primary
