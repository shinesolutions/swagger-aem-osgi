          optional = false
        }
        proxy_port {
          type = ConfigNodePropertyInteger
          description = ""
          optional = false
        }
        proxy_user {
          type = ConfigNodePropertyString
          description = ""
          optional = false
        }
        proxy_password {
          type = ConfigNodePropertyString
          description = ""
          optional = false
        }
        proxy_exceptions {
          type = ConfigNodePropertyArray
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  OrgApacheHttpProxyconfiguratorProperties {
    title = OrgApacheHttpProxyconfiguratorProperties
